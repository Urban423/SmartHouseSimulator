{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 14,
		"patch": 0
	},
	"configurePresets": [ 
	{
		"name": "base",
		"hidden": true,
		"generator": "Ninja",
		"binaryDir": "${sourceDir}/.CMakeFiles",
		"cacheVariables": {
			"CMAKE_PROJECT_NAME": "OnlineAlpha",
			"CMAKE_PROGRAM_NAME": "OnlineAlpha",
			"PROGRAM_INPUT_DATA": "",
			"PROGRAM_VERSION"	: "1.0",
			"ENABLE_VERSIONING_BUILD": "ON",
			"NUM_LIBRARIES": "7",
			"LIBRARY_0": "Math",
			"LIBRARY_1": "Algorithms",
			"LIBRARY_2": "ImageEditor",
			"LIBRARY_3": "IOSystem",
			"LIBRARY_4": "GraphicsEngine",
			"LIBRARY_5": "Logic",
			"LIBRARY_6": "App"
		}
	},
	{
		"name": "windows",
		"inherits": "base",
		"cacheVariables": {
			"CMAKE_SYSTEM_NAME":	"Windows",
			"CMAKE_C_COMPILER": 	"x86_64-w64-mingw32-gcc",
			"CMAKE_CXX_COMPILER": 	"x86_64-w64-mingw32-g++",
			"CMAKE_FIND_ROOT_PATH":	"/usr/x86_64-w64-mingw32",
			"RENDERTYPE": "glad"
		}
	},
	{
		"name": "android",
		"inherits": "base",
		"cacheVariables": {
			"CMAKE_SYSTEM_NAME":	"Android",
			"CMAKE_C_COMPILER": 	"x86_64-w64-mingw32-gcc",
			"CMAKE_CXX_COMPILER": 	"x86_64-w64-mingw32-g++",
			"CMAKE_FIND_ROOT_PATH":	"/usr/x86_64-w64-mingw32",
			"RENDERTYPE": "glad"
		}
	}
	]
}
