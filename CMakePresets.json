{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 14,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.CMakeFiles",
            "cacheVariables": {
                "CMAKE_PROJECT_NAME": "GlassWars",
                "CMAKE_PROGRAM_NAME": "GlassWars",
                "PROGRAM_INPUT_DATA": "",
                "PROGRAM_VERSION": "1.0",
                "ENABLE_VERSIONING_BUILD": "ON",
                "NUM_LIBRARIES": "9",
                "LIBRARY_0": "Math",
                "LIBRARY_1": "Graph",
                "LIBRARY_2": "Tree",
                "LIBRARY_3": "GraphicsEngine",
                "LIBRARY_4": "Algorithms",
                "LIBRARY_5": "ImageEditor",
                "LIBRARY_6": "IOSystem",
                "LIBRARY_7": "Logic",
                "LIBRARY_8": "App"
            }
        },
        {
            "name": "windows",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
                "CMAKE_FIND_ROOT_PATH": "/usr/x86_64-w64-mingw32",
                "RENDERTYPE": "glad"
            }
        },
        {
            "name": "android",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
                "CMAKE_FIND_ROOT_PATH": "/usr/x86_64-w64-mingw32",
                "RENDERTYPE": "glad"
            }
        }
    ]
}